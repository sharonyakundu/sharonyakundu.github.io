---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { roles, education, languages, skills } from '../data/experience';
---

<Base
  title="CV"
  description="CV of Sharonya Kundu: experience in digital marketing, customer service and logistics, with a master’s in Media and Communication Management."
>
  <header class="page-head col">
    <h1>Sharonya Kundu</h1>
    <p class="lead">Digital marketing · Customer service · Logistics</p>
    {
      site.cvFile && (
        <p>
          <a class="button" href={site.cvFile} download>
            Download PDF
          </a>
        </p>
      )
    }
  </header>

  <section class="col" aria-labelledby="experience">
    <h2 id="experience">Experience</h2>
    <ul class="rows list">
      {
        roles.map((role) => (
          <li>
            <span class="mono">{role.dates}</span>
            <div>
              <h3>{role.title}</h3>
              <p>
                {role.company}, {role.place}
              </p>
              <ul>
                {role.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="col section" aria-labelledby="education">
    <h2 id="education">Education</h2>
    <ul class="rows list">
      {
        education.map((item) => (
          <li>
            <span class="mono">{item.dates}</span>
            <div>
              <h3>{item.degree}</h3>
              <p>{item.school}</p>
              <p class="mono">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="col last" aria-labelledby="skills">
    <h2 id="skills">Skills and languages</h2>
    <ul class="rows list">
      {
        skills.map((group) => (
          <li>
            <span class="label">{group.group}</span>
            <p>{group.items.join(', ')}</p>
          </li>
        ))
      }
      <li>
        <span class="label">Languages</span>
        <p>{languages.map((language) => `${language.name} (${language.level})`).join(', ')}</p>
      </li>
    </ul>
  </section>
</Base>

<style>
  .list {
    margin-top: 28px;
  }

  .last {
    padding-bottom: clamp(48px, 9vw, 104px);
  }
</style>
