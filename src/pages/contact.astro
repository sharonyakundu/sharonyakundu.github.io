---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Contact"
  description="Contact Sharonya Kundu in Wrocław, Poland, by email or LinkedIn about roles in digital marketing, customer service and logistics."
>
  <header class="page-head col">
    <span class="label">Contact</span>
    <h1>Say hello.</h1>
    <p class="lead">I’m open to roles in digital marketing, customer service and logistics.</p>
  </header>

  <section class="col last">
    <ul class="rows">
      <li>
        <span class="label">Email</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      {
        site.linkedin && (
          <li>
            <span class="label">LinkedIn</span>
            <a href={site.linkedin} rel="me noopener">
              {site.linkedin.replace('https://www.', '')}
            </a>
          </li>
        )
      }
      {
        site.instagram && (
          <li>
            <span class="label">Instagram</span>
            <a href={site.instagram} rel="me noopener">
              {site.instagram.replace('https://www.', '')}
            </a>
          </li>
        )
      }
      <li>
        <span class="label">Based in</span>
        <span>Wrocław, Poland</span>
      </li>
    </ul>
  </section>
</Base>

<style>
  .last {
    padding-bottom: clamp(48px, 9vw, 104px);
  }

  .rows a {
    overflow-wrap: anywhere;
  }
</style>
