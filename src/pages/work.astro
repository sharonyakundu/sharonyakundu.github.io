---
import Base from '../layouts/Base.astro';
import Vcr from '../components/Vcr.astro';
import Tape from '../components/Tape.astro';
import { tapes, certificates } from '../data/work';

// Each frame hangs a little crooked, and at its own height.
const tilts = [-1.4, 0.9, -0.5, 1.3, -1, 0.6, -0.8];
const drops = [0, 26, 8, 30, 4, 22, 12];
---

<Base
  title="Work and certificates"
  description="Certificates and short-form video work by Sharonya Kundu: SEO, digital marketing, design, photography and data analysis courses, and Instagram reels."
>
  <header class="page-head col">
    <span class="label">Work</span>
    <h1>Certificates and reels</h1>
  </header>

  <!-- The wall of framed certificates -->
  <section class="wall wide" aria-labelledby="certificates">
    <h2 id="certificates" class="sr-only">Certificates</h2>
    <ul class="frames">
      {
        certificates.map((c, i) => (
          <li class="piece" style={`--tilt:${tilts[i % tilts.length]}deg;--drop:${drops[i % drops.length]}px`}>
            <div class="swing" data-swing>
              <span class="nail" aria-hidden="true" />
              <svg class="wire" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
                <path d="M14 40 L50 1 L86 40" />
              </svg>
              <a class={`frame frame-${c.frame}`} href={`/certificates/${c.image}.webp`} data-view data-caption={c.title}>
                <span class="mat">
                  <img
                    src={`/certificates/${c.image}-thumb.webp`}
                    width={c.width}
                    height={c.height}
                    alt={`Certificate of completion: ${c.title}, ${c.issuer}`}
                    loading={i < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </span>
                <span class="sheen" aria-hidden="true" />
              </a>
            </div>
            <div class="plaque">
              <h3>{c.title}</h3>
              <p class="mono">
                {c.issuer} · {c.date}
                {c.hours && ` · ${c.hours}`}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- The VCR and the tapes -->
  <section class="media col" aria-labelledby="reels">
    <h2 id="reels">Reels</h2>
    <p class="hint">Pick a tape and it goes into the recorder.</p>
    <div class="shelf-unit">
      <Vcr />
      <div class="shelf" aria-hidden="true"></div>
    </div>
    <ul class="tapes">
      {tapes.map((tape, index) => <Tape tape={tape} index={index} />)}
    </ul>
  </section>

  <dialog class="viewer" aria-label="Certificate">
    <form method="dialog"><button class="label close">Close ✕</button></form>
    <img data-viewer-img alt="" />
    <p class="mono" data-viewer-caption></p>
  </dialog>

  <dialog class="player" aria-label="Reel player">
    <div class="player-head">
      <p class="label" data-player-title></p>
      <form method="dialog"><button class="label close">Eject ⏏</button></form>
    </div>
    <div class="screen" data-screen></div>
    <a class="label out" data-player-link href="#" rel="noopener">Open on Instagram</a>
  </dialog>
</Base>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Frames: swing on the nail when touched, open large when clicked.
  document.querySelectorAll<HTMLElement>('[data-swing]').forEach((frame) => {
    const swing = () => {
      if (reduced) return;
      frame.classList.remove('swinging');
      void frame.offsetWidth; // restart the animation
      frame.classList.add('swinging');
    };
    frame.addEventListener('pointerenter', swing);
    frame.addEventListener('focusin', swing);
    frame.addEventListener('animationend', () => frame.classList.remove('swinging'));
  });

  const viewer = document.querySelector<HTMLDialogElement>('.viewer');
  const viewerImg = document.querySelector<HTMLImageElement>('[data-viewer-img]');
  const viewerCaption = document.querySelector<HTMLElement>('[data-viewer-caption]');
  document.querySelectorAll<HTMLAnchorElement>('[data-view]').forEach((link) => {
    link.addEventListener('click', (e) => {
      if (!viewer || !viewerImg || !viewerCaption) return;
      e.preventDefault();
      viewerImg.src = link.href;
      viewerImg.alt = link.querySelector('img')?.alt ?? '';
      viewerCaption.textContent = link.dataset.caption ?? '';
      viewer.showModal();
    });
  });

  // ---- Tapes: fly into the VCR slot, then play the reel.
  const vcr = document.querySelector<HTMLElement>('[data-vcr]');
  const slot = document.querySelector<SVGRectElement>('[data-slot]');
  const display = document.querySelector<SVGTextElement>('[data-display]');
  const player = document.querySelector<HTMLDialogElement>('.player');
  const screen = document.querySelector<HTMLElement>('[data-screen]');
  const playerTitle = document.querySelector<HTMLElement>('[data-player-title]');
  const playerLink = document.querySelector<HTMLAnchorElement>('[data-player-link]');
  let current: HTMLAnchorElement | null = null;

  const setVcr = (state: 'idle' | 'loading' | 'playing', text: string) => {
    if (vcr) vcr.dataset.state = state;
    if (display) display.textContent = text;
  };

  const play = (tape: HTMLAnchorElement) => {
    if (!player || !screen) return;
    const reel = tape.dataset.reel ?? '';
    const frame = document.createElement('iframe');
    frame.src = `https://www.instagram.com/reel/${encodeURIComponent(reel)}/embed/`;
    frame.title = tape.dataset.title ?? 'Instagram reel';
    frame.allow = 'autoplay; encrypted-media; picture-in-picture';
    screen.replaceChildren(frame);
    if (playerTitle) playerTitle.textContent = tape.dataset.title ?? '';
    if (playerLink) playerLink.href = tape.href;
    setVcr('playing', 'PLAY');
    player.showModal();
  };

  const insert = async (tape: HTMLAnchorElement) => {
    const art = tape.querySelector('svg');
    if (!slot || !art || reduced) return play(tape);

    const from = art.getBoundingClientRect();
    const to = slot.getBoundingClientRect();
    const ghost = art.cloneNode(true) as SVGSVGElement;
    Object.assign(ghost.style, {
      position: 'fixed',
      left: `${from.left}px`,
      top: `${from.top}px`,
      width: `${from.width}px`,
      height: `${from.height}px`,
      zIndex: '50',
      pointerEvents: 'none',
    });
    document.body.append(ghost);
    tape.style.visibility = 'hidden';
    setVcr('loading', 'LOAD');

    const dx = to.left + to.width / 2 - (from.left + from.width / 2);
    const dy = to.top + to.height / 2 - (from.top + from.height / 2);
    const s = (to.width * 0.94) / from.width;
    const flight = ghost.animate(
      [
        { transform: 'translate(0, 0) scale(1) rotate(0deg)' },
        { transform: `translate(${dx}px, ${dy - 40}px) scale(${s}) rotate(-4deg)`, offset: 0.55 },
        { transform: `translate(${dx}px, ${dy}px) scale(${s}) rotate(0deg)`, offset: 0.75 },
        { transform: `translate(${dx}px, ${dy}px) scale(${s * 0.97}, 0.04)`, opacity: 0.4 },
      ],
      { duration: 1000, easing: 'cubic-bezier(.22,1,.36,1)' },
    );
    await flight.finished.catch(() => {});
    ghost.remove();
    window.setTimeout(() => play(tape), 350);
  };

  document.querySelectorAll<HTMLAnchorElement>('a.tape[data-reel]').forEach((tape) => {
    tape.addEventListener('click', (e) => {
      e.preventDefault();
      if (current) return;
      current = tape;
      void insert(tape);
    });
  });

  // Eject: the player stops and the tape comes back to its place.
  player?.addEventListener('close', () => {
    screen?.replaceChildren();
    setVcr('idle', '12:00');
    if (current) {
      current.style.visibility = '';
      if (!reduced) current.animate([{ transform: 'translateY(-30px)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 450, easing: 'cubic-bezier(.22,1,.36,1)' });
      current.focus({ preventScroll: true });
    }
    current = null;
  });

  // Clicking the dark area around a dialog closes it.
  [viewer, player].forEach((dialog) =>
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    }),
  );
</script>

<style>
  .page-head {
    padding-bottom: 8px;
  }

  /* ---------- the wall ---------- */
  .frames {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 40px 48px;
    list-style: none;
    margin: 0;
    padding: 36px 0 0;
  }

  .piece {
    width: min(232px, 100%);
    margin-top: var(--drop);
    display: grid;
    justify-items: center;
  }

  .swing {
    position: relative;
    width: 100%;
    padding-top: 30px;
    transform: rotate(var(--tilt));
    transform-origin: 50% 0;
  }

  /* A frame bumped on its nail swings and settles. */
  .swing.swinging {
    animation: frame-swing 1.15s cubic-bezier(0.3, 0.6, 0.3, 1);
  }

  .nail {
    position: absolute;
    top: -3px;
    left: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle at 35% 35%, #d9d2c4, #6f685c 70%);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    z-index: 2;
  }

  .wire {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 32px;
    overflow: visible;
  }

  .wire path {
    fill: none;
    stroke: #7d756a;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .frame {
    position: relative;
    display: block;
    padding: 12px;
    border-radius: 2px;
    box-shadow:
      0 14px 22px -10px rgba(30, 15, 0, 0.5),
      0 2px 4px rgba(30, 15, 0, 0.25);
  }

  .frame:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }

  /* Five kinds of frame. */
  .frame-oak {
    background-color: #a8703f;
    background-image:
      linear-gradient(rgba(255, 240, 220, 0.22), rgba(40, 20, 5, 0.22)),
      url('/window/wood-h.svg');
    background-size:
      auto,
      640px 160px;
  }
  .frame-walnut {
    background-color: #5b3a22;
    background-image:
      linear-gradient(rgba(30, 15, 5, 0.45), rgba(30, 15, 5, 0.6)),
      url('/window/wood-h.svg');
    background-size:
      auto,
      640px 160px;
  }
  .frame-gilt {
    padding: 14px;
    background:
      repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.08) 0 2px, transparent 2px 5px),
      linear-gradient(135deg, #8a6420 0%, #f3d98c 22%, #b58a33 45%, #f6e1a2 62%, #8f6a24 100%);
  }
  .frame-black {
    padding: 9px;
    background: linear-gradient(135deg, #3a3a3e, #0d0d0f 60%, #26262a);
  }
  .frame-white {
    padding: 10px;
    background: linear-gradient(135deg, #ffffff, #e9e4da 70%, #f6f2ea);
  }

  /* Bevel on every frame. */
  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.45),
      inset -1px -1px 0 rgba(0, 0, 0, 0.35),
      inset 0 0 0 4px rgba(0, 0, 0, 0.06);
  }

  .mat {
    display: block;
    padding: 12px;
    background: #f7f3ea;
    box-shadow:
      inset 2px 2px 4px rgba(0, 0, 0, 0.28),
      inset -1px -1px 0 rgba(255, 255, 255, 0.6);
  }

  .mat img {
    width: 100%;
    height: auto;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  /* Light catching the glass. */
  .sheen {
    position: absolute;
    inset: 12px;
    pointer-events: none;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 32%, rgba(255, 255, 255, 0) 58%, rgba(255, 255, 255, 0.12) 72%, rgba(255, 255, 255, 0) 86%);
  }

  .plaque {
    margin-top: 18px;
    padding: 8px 12px;
    max-width: 220px;
    text-align: center;
  }

  .plaque h3 {
    font-size: 0.98rem;
    line-height: 1.25;
    margin-bottom: 4px;
  }

  .plaque p {
    margin: 0;
    font-size: 0.7rem;
  }

  :global([data-theme='dark']) .mat img,
  :global([data-theme='dark']) .mat {
    filter: brightness(0.82);
  }

  /* ---------- the VCR ---------- */
  .media {
    padding-block: clamp(56px, 10vw, 112px);
    text-align: center;
  }

  .hint {
    margin: 8px 0 32px;
    color: var(--mute);
  }

  .shelf-unit {
    display: grid;
    justify-items: center;
  }

  .shelf {
    width: min(540px, 100%);
    height: 16px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: #a8703f;
    background-image:
      linear-gradient(rgba(255, 240, 220, 0.25), rgba(40, 20, 5, 0.3)),
      url('/window/wood-h.svg');
    background-size:
      auto,
      640px 160px;
    box-shadow: 0 14px 18px -12px rgba(30, 15, 0, 0.6);
  }

  :global([data-theme='dark']) .shelf {
    filter: brightness(0.62);
  }

  .tapes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px 32px;
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
  }

  /* ---------- dialogs ---------- */
  dialog {
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    color: var(--body);
  }

  dialog::backdrop {
    background: rgba(6, 6, 6, 0.7);
  }

  .viewer {
    width: min(960px, 100% - 24px);
  }

  .viewer img {
    width: 100%;
    height: auto;
  }

  .viewer p {
    margin: 10px 4px 2px;
  }

  dialog form {
    display: flex;
    justify-content: flex-end;
  }

  .close {
    background: none;
    border: 0;
    padding: 6px 4px 10px;
    cursor: pointer;
  }

  .player {
    width: min(420px, 100% - 24px);
  }

  .player-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .player-head p {
    margin: 0;
    padding-bottom: 4px;
  }

  .screen :global(iframe) {
    display: block;
    width: 100%;
    height: min(72vh, 680px);
    border: 0;
    border-radius: 6px;
    background: var(--bg);
  }

  .out {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.65rem;
    text-decoration: none;
  }

  @keyframes frame-swing {
    0% {
      transform: rotate(var(--tilt));
    }
    18% {
      transform: rotate(calc(var(--tilt) + 3.2deg));
    }
    40% {
      transform: rotate(calc(var(--tilt) - 2.2deg));
    }
    62% {
      transform: rotate(calc(var(--tilt) + 1.1deg));
    }
    82% {
      transform: rotate(calc(var(--tilt) - 0.4deg));
    }
    100% {
      transform: rotate(var(--tilt));
    }
  }
</style>
