---
// A video cassette recorder on a wooden shelf. The work page script
// slides tapes into its slot and drives the little display.
---

<div class="vcr" data-vcr data-state="idle">
  <svg viewBox="0 0 520 120" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="vcr-body" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3a3a3f"></stop>
        <stop offset="1" stop-color="#1c1c20"></stop>
      </linearGradient>
      <linearGradient id="vcr-face" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2b2b30"></stop>
        <stop offset="1" stop-color="#202024"></stop>
      </linearGradient>
    </defs>

    <rect class="foot" x="40" y="108" width="34" height="8" rx="2"></rect>
    <rect class="foot" x="446" y="108" width="34" height="8" rx="2"></rect>
    <rect x="6" y="14" width="508" height="96" rx="7" fill="url(#vcr-body)"></rect>
    <path class="ridges" d="M30 20 H490 M30 24 H490"></path>
    <rect x="14" y="30" width="492" height="72" rx="4" fill="url(#vcr-face)"></rect>
    <path class="bevel" d="M14 30.5 H506"></path>

    <!-- tape slot with its spring flap -->
    <rect class="slot-surround" x="34" y="40" width="212" height="38" rx="3"></rect>
    <rect class="slot" data-slot x="40" y="45" width="200" height="28" rx="2"></rect>
    <g class="flap">
      <rect x="40" y="45" width="200" height="28" rx="2"></rect>
      <path d="M44 49 H236"></path>
    </g>
    <text class="print" x="140" y="92" text-anchor="middle">VIDEO CASSETTE RECORDER</text>

    <!-- display -->
    <rect class="screen" x="290" y="40" width="128" height="34" rx="3"></rect>
    <text class="digits" data-display x="354" y="64" text-anchor="middle">12:00</text>
    <text class="tiny play-sign" x="298" y="50">▶</text>
    <text class="tiny" x="398" y="50">HI-FI</text>

    <!-- buttons -->
    {
      ['⏏', '■', '◀◀', '▶', '▶▶'].map((sign, i) => (
        <g>
          <rect class="key" x={292 + i * 25.5} y="82" width="20" height="9" rx="2" />
          <text class="tiny key-sign" x={302 + i * 25.5} y="99" text-anchor="middle">
            {sign}
          </text>
        </g>
      ))
    }

    <!-- power -->
    <circle class="power" cx="470" cy="56" r="9"></circle>
    <circle class="power-ring" cx="470" cy="56" r="5"></circle>
    <circle class="led" cx="470" cy="80" r="2.6"></circle>
    <text class="tiny" x="470" y="95" text-anchor="middle">POWER</text>
  </svg>
</div>

<style>
  .vcr {
    width: min(460px, 100%);
    margin: 0 auto;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 10px 12px rgba(20, 10, 0, 0.35));
  }

  .foot {
    fill: #111113;
  }
  .ridges {
    stroke: rgba(255, 255, 255, 0.06);
    stroke-width: 1.5;
  }
  .bevel {
    stroke: rgba(255, 255, 255, 0.1);
  }
  .slot-surround {
    fill: #18181b;
  }
  .slot {
    fill: #050506;
  }
  .flap rect {
    fill: #141416;
  }
  .flap path {
    stroke: rgba(255, 255, 255, 0.12);
  }
  .flap {
    transform-box: fill-box;
    transform-origin: 50% 0;
    transition: transform 0.35s var(--ease);
  }
  [data-state='loading'] .flap {
    transform: scaleY(0.12);
  }

  .print,
  .tiny {
    font-family: var(--sans);
    fill: #8d8d93;
  }
  .print {
    font-size: 7px;
    letter-spacing: 2.2px;
  }
  .tiny {
    font-size: 6px;
    letter-spacing: 0.6px;
  }

  .screen {
    fill: #0b120f;
    stroke: #000;
  }
  .digits {
    font-family: var(--mono);
    font-size: 18px;
    letter-spacing: 1px;
    fill: #79f2b0;
  }
  /* The classic: a VCR nobody set, blinking 12:00. */
  [data-state='idle'] .digits {
    animation: vcr-blink 1s steps(1) infinite;
  }
  .play-sign {
    fill: #79f2b0;
    opacity: 0;
  }
  [data-state='playing'] .play-sign {
    opacity: 1;
  }

  .key {
    fill: #3a3a40;
    stroke: #121214;
  }
  .key-sign {
    font-size: 6.5px;
  }
  .power {
    fill: #2e2e33;
    stroke: #121214;
  }
  .power-ring {
    fill: none;
    stroke: #8d8d93;
    stroke-width: 1;
  }
  .led {
    fill: #3a1512;
    transition: fill 0.2s;
  }
  [data-state='loading'] .led,
  [data-state='playing'] .led {
    fill: #ff4a3d;
  }

  @keyframes vcr-blink {
    50% {
      opacity: 0.1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .digits {
      animation: none !important;
    }
  }
</style>
