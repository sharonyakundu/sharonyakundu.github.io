---
// A cream wall mailbox with a brass flap, name plate and keyhole.
// A sealed envelope waits half in its slot; pushing it in (or waiting
// a moment) drops it inside, the flap swings and a tag answers.
import Envelope from './Envelope.astro';
---

<div class="mailbox" data-mailbox>
  <svg class="box" viewBox="0 0 216 276" aria-hidden="true">
    <defs>
      <linearGradient id="mb-body" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f4eee2"></stop>
        <stop offset="0.55" stop-color="#e7dfcf"></stop>
        <stop offset="1" stop-color="#d3c8b3"></stop>
      </linearGradient>
      <linearGradient id="mb-hood" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f7f2e8"></stop>
        <stop offset="1" stop-color="#e3dbca"></stop>
      </linearGradient>
      <linearGradient id="mb-panel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ece5d6"></stop>
        <stop offset="1" stop-color="#e2d9c7"></stop>
      </linearGradient>
      <linearGradient id="mb-brass" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f3dc9c"></stop>
        <stop offset="0.45" stop-color="#c9a04a"></stop>
        <stop offset="1" stop-color="#8d6825"></stop>
      </linearGradient>
      <radialGradient id="mb-brass-r" cx="0.36" cy="0.3" r="0.8">
        <stop offset="0" stop-color="#fbe8b0"></stop>
        <stop offset="0.5" stop-color="#c9a04a"></stop>
        <stop offset="1" stop-color="#7b581d"></stop>
      </radialGradient>
    </defs>

    <!-- body and hood -->
    <rect x="4" y="4" width="208" height="268" rx="26" fill="url(#mb-body)"></rect>
    <path d="M4 66 V30 a26 26 0 0 1 26 -26 H186 a26 26 0 0 1 26 26 V66 Z" fill="url(#mb-hood)"></path>
    <path d="M7 66 H209" stroke="rgba(90,70,40,0.28)" stroke-width="1.6"></path>
    <path d="M7 67.8 H209" stroke="rgba(255,255,255,0.65)" stroke-width="1"></path>

    <!-- the slot and its hinges -->
    <rect x="14" y="19" width="188" height="35" rx="6" fill="#d3c9b5"></rect>
    <rect x="14" y="19" width="188" height="35" rx="6" fill="none" stroke="rgba(80,60,30,0.18)"></rect>
    <rect x="19.3" y="24.5" width="177.4" height="24.6" rx="2.5" fill="#0d0a07"></rect>
    <rect x="11" y="22" width="10" height="13" rx="3.5" fill="url(#mb-brass)"></rect>
    <rect x="195" y="22" width="10" height="13" rx="3.5" fill="url(#mb-brass)"></rect>

    <!-- door panel -->
    <rect x="22" y="80" width="172" height="176" rx="10" fill="url(#mb-panel)"></rect>
    <rect x="22" y="80" width="172" height="176" rx="10" fill="none" stroke="rgba(110,90,60,0.3)" stroke-width="2"></rect>
    <rect x="25" y="83" width="166" height="170" rx="8" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1.2"></rect>

    <!-- name plate -->
    <rect x="60" y="103" width="96" height="22" rx="11" fill="url(#mb-brass)"></rect>
    <rect x="60.6" y="103.6" width="94.8" height="20.8" rx="10.4" fill="none" stroke="rgba(255,240,200,0.6)" stroke-width="0.8"></rect>
    <circle cx="71" cy="114" r="2.4" fill="#8d6825"></circle>
    <circle cx="145" cy="114" r="2.4" fill="#8d6825"></circle>
    <text x="108" y="118" text-anchor="middle" class="plate">S. KUNDU</text>

    <!-- keyhole -->
    <circle cx="108" cy="168" r="12" fill="url(#mb-brass-r)"></circle>
    <path d="M108 161.5 a3.5 3.5 0 0 1 2 6.3 l1.3 6.4 h-6.6 l1.3 -6.4 a3.5 3.5 0 0 1 2 -6.3z" fill="#2a1d0c"></path>

    <!-- light along the rounded edges -->
    <rect x="4.8" y="4.8" width="206.4" height="266.4" rx="25.2" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="1.6"></rect>
    <rect x="4" y="4" width="208" height="268" rx="26" fill="none" stroke="rgba(90,70,40,0.22)" stroke-width="1"></rect>
  </svg>

  <span class="flap" aria-hidden="true"><i></i></span>

  <!-- The envelope waits here, half inside the slot. -->
  <span class="slot">
    <span class="letter" data-slot-letter hidden>
      <Envelope />
    </span>
  </span>

  <span class="mail-tag" data-mail-tag role="status" aria-live="polite"></span>
</div>

<style>
  .mailbox {
    position: relative;
    width: clamp(170px, 42vw, 216px);
    margin: 0 auto;
  }

  .box {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 20px rgba(40, 30, 15, 0.28));
  }

  .plate {
    font: 600 8.5px/1 var(--mono);
    letter-spacing: 1.6px;
    fill: rgba(70, 45, 8, 0.75);
  }

  /* The flap over the slot swings in on its hinges. */
  .flap {
    position: absolute;
    left: 8.935%;
    top: 8.871%;
    width: 81.79%;
    aspect-ratio: 476 / 66;
    background: #0d0a07;
    perspective: 300px;
  }
  .flap i {
    position: absolute;
    inset: 0;
    border-radius: 2px;
    transform-origin: 50% 0;
    background: linear-gradient(#f1ebdf, #ddd3c0);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      inset 0 -2px 3px rgba(90, 70, 40, 0.22);
  }
  .mailbox.sent .flap i {
    animation: flap-swing 1s cubic-bezier(0.35, 0, 0.4, 1) 0.3s;
  }

  /* Everything below this line is inside the box. */
  .slot {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 80.8%;
    height: 200px;
    overflow: hidden;
    pointer-events: none;
  }
  .letter {
    position: absolute;
    left: 12%;
    bottom: 0;
    width: 76%;
    transform: translateY(34%) rotate(-1deg);
    filter: drop-shadow(0 2px 3px rgba(40, 30, 15, 0.35));
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    user-select: none;
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .letter[hidden] {
    display: none;
  }
  .mailbox.ready .letter:hover {
    transform: translateY(26%) rotate(0.5deg);
  }
  .mailbox.pushing .letter {
    cursor: grabbing;
    transition: none;
  }
  .mailbox.sent .letter {
    transform: translateY(104%);
    transition: transform 0.38s cubic-bezier(0.5, 0, 0.8, 0.6);
  }

  .mail-tag {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: calc(100% + 10px);
    padding: 7px 12px;
    border-radius: 2px;
    background: #efe7d6;
    color: #17160f;
    box-shadow:
      0 1px 1px rgba(40, 30, 15, 0.14),
      0 10px 18px -8px rgba(40, 30, 15, 0.4);
    font: 500 12px/1.4 var(--sans);
    width: max-content;
    max-width: min(320px, 86vw);
    text-align: center;
    opacity: 0;
    translate: -50% -6px;
    rotate: -1deg;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      translate 0.35s var(--ease);
  }
  .mail-tag.on {
    opacity: 1;
    translate: -50% 0;
  }

  :global([data-theme='dark']) .box {
    filter: brightness(0.86) drop-shadow(0 18px 22px rgba(0, 0, 0, 0.6));
  }
  :global([data-theme='dark']) .flap i {
    filter: brightness(0.86);
  }

  @keyframes flap-swing {
    16% {
      transform: rotateX(-38deg);
    }
    38% {
      transform: rotateX(20deg);
    }
    58% {
      transform: rotateX(-11deg);
    }
    76% {
      transform: rotateX(5deg);
    }
    90% {
      transform: rotateX(-2deg);
    }
  }
</style>
