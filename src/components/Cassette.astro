---
// One cassette tape, drawn entirely with CSS. Pressing it loads the reel.
import type { Tape } from '../data/work';

interface Props {
  tape: Tape;
  index: number;
}

const { tape, index } = Astro.props;
const ready = tape.reel !== '';
const number = String(index + 1).padStart(2, '0');
const address = `https://www.instagram.com/reel/${tape.reel}/`;
---

<div class="slot">
  <button class="tape" type="button" data-reel={tape.reel} data-title={tape.title} disabled={!ready}>
    <span class="sticker">
      <span class="top">
        <span class="mono">Side A · {number}</span>
        <span class="mono">{tape.year}</span>
      </span>
      <span class="title">{tape.title}</span>
      <span class="mono">{tape.client}</span>
    </span>
    <span class="deck" aria-hidden="true">
      <span class="reel"></span>
      <span class="band"></span>
      <span class="reel"></span>
    </span>
    <span class="label state">{ready ? 'Press to play' : 'Coming soon'}</span>
  </button>
  {
    ready && (
      <a class="label out" href={address} rel="noopener">
        Open on Instagram
      </a>
    )
  }
</div>

<style>
  .slot {
    display: grid;
    gap: 10px;
    justify-items: center;
  }

  .tape {
    all: unset;
    box-sizing: border-box;
    display: grid;
    grid-template-rows: 1fr auto auto;
    gap: 10px;
    width: 100%;
    aspect-ratio: 1.58;
    padding: 14px 16px 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background:
      radial-gradient(circle at 10px 10px, var(--mute) 1.5px, transparent 2px),
      radial-gradient(circle at calc(100% - 10px) 10px, var(--mute) 1.5px, transparent 2px),
      radial-gradient(circle at 10px calc(100% - 10px), var(--mute) 1.5px, transparent 2px),
      radial-gradient(circle at calc(100% - 10px) calc(100% - 10px), var(--mute) 1.5px, transparent 2px),
      var(--paper);
    box-shadow: 0 14px 28px -18px rgba(23, 22, 15, 0.55);
    cursor: pointer;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .tape:not(:disabled):hover,
  .tape:not(:disabled):focus-visible {
    transform: translateY(-4px) rotate(-0.6deg);
    box-shadow: 0 22px 34px -18px rgba(23, 22, 15, 0.6);
  }

  .tape:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }

  .tape:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .sticker {
    display: grid;
    align-content: space-between;
    gap: 4px;
    padding: 10px 12px;
    margin-inline: 10px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-bottom: 3px solid var(--blue);
    border-radius: 4px;
    text-align: left;
  }

  .top {
    display: flex;
    justify-content: space-between;
  }

  .title {
    font-family: var(--head);
    font-size: 1.15rem;
    line-height: 1.15;
    color: var(--ink);
  }

  .deck {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
  }

  .reel {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 5px solid var(--ink);
    background: repeating-conic-gradient(var(--mute) 0 12deg, transparent 12deg 60deg);
  }

  .band {
    width: 46px;
    height: 12px;
    border-radius: 2px;
    background: var(--ink);
    opacity: 0.75;
  }

  .tape:not(:disabled):hover .reel,
  .tape:not(:disabled):focus-visible .reel {
    animation: spin 1.6s linear infinite;
  }

  .state {
    text-align: center;
    font-size: 0.65rem;
  }

  .out {
    text-decoration: none;
    font-size: 0.65rem;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
