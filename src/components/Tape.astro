---
// One small VHS tape. Hovering turns its reels; clicking puts it in the VCR.
import type { Tape } from '../data/work';

interface Props {
  tape: Tape;
  index: number;
}

const { tape, index } = Astro.props;
const ready = tape.reel !== '';
const number = String(index + 1).padStart(2, '0');
const href = `https://www.instagram.com/reel/${tape.reel}/`;
const meta = [tape.client, tape.year].filter(Boolean).join(' · ');
const Tag = ready ? 'a' : 'span';
---

<li class="slot">
  <Tag
    class="tape"
    href={ready ? href : undefined}
    rel={ready ? 'noopener' : undefined}
    data-reel={ready ? tape.reel : undefined}
    data-title={tape.title}
    aria-label={ready ? `Play reel: ${tape.title}` : undefined}
    aria-disabled={ready ? undefined : 'true'}
    style={`--accent:${tape.colour}`}
  >
    <svg viewBox="0 0 188 104" aria-hidden="true" focusable="false">
      <rect class="body" width="188" height="104" rx="5"></rect>
      <rect class="edge" x="2" y="2" width="184" height="100" rx="4"></rect>
      <rect class="sticker" x="12" y="8" width="164" height="25" rx="2"></rect>
      <rect class="stripe" x="12" y="8" width="164" height="5" rx="1"></rect>
      <text class="sticker-text" x="20" y="27">{number}</text>
      <path class="sticker-lines" d="M44 23.5 H166 M44 29 H140"></path>
      <rect class="window" x="40" y="42" width="108" height="44" rx="4"></rect>
      <circle class="wound" cx="72" cy="64" r="18"></circle>
      <circle class="wound" cx="116" cy="64" r="11.5"></circle>
      <g class="hub">
        <circle cx="72" cy="64" r="9"></circle>
        <path d="M72 55 v4 M72 69 v4 M63 64 h4 M77 64 h4 M65.6 57.6 l2.8 2.8 M75.6 67.6 l2.8 2.8"></path>
        <circle class="hole" cx="72" cy="64" r="3.4"></circle>
      </g>
      <g class="hub">
        <circle cx="116" cy="64" r="9"></circle>
        <path d="M116 55 v4 M116 69 v4 M107 64 h4 M121 64 h4 M109.6 57.6 l2.8 2.8 M119.6 67.6 l2.8 2.8"></path>
        <circle class="hole" cx="116" cy="64" r="3.4"></circle>
      </g>
      <rect class="glass" x="40" y="42" width="108" height="44" rx="4"></rect>
      <circle class="screw" cx="9" cy="95" r="2"></circle>
      <circle class="screw" cx="179" cy="95" r="2"></circle>
      <path class="grip" d="M14 92 H32 M14 96 H32 M156 92 H174 M156 96 H174"></path>
    </svg>
  </Tag>
  <p class="title">{tape.title}</p>
  {meta && <p class="mono meta">{meta}</p>}
</li>

<style>
  .slot {
    display: grid;
    justify-items: center;
    gap: 2px;
    width: 132px;
    text-align: center;
  }

  .tape {
    display: block;
    width: 100%;
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.35s var(--ease);
    -webkit-tap-highlight-color: transparent;
  }

  .tape[aria-disabled='true'] {
    cursor: default;
    opacity: 0.55;
  }

  a.tape:hover,
  a.tape:focus-visible {
    transform: translateY(-4px) rotate(-1.5deg);
  }

  .tape svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 10px rgba(20, 10, 0, 0.35));
  }

  .body {
    fill: #1d1d21;
  }
  .edge {
    fill: none;
    stroke: rgba(255, 255, 255, 0.08);
  }
  .sticker {
    fill: #f2ead8;
  }
  .stripe {
    fill: var(--accent);
  }
  .sticker-text {
    font-family: var(--mono);
    font-size: 11px;
    fill: #2b2b2b;
  }
  .sticker-lines {
    stroke: rgba(40, 40, 40, 0.25);
    stroke-width: 0.8;
  }
  .window {
    fill: #3b3a40;
  }
  .wound {
    fill: #2b1f19;
  }
  .hub circle {
    fill: #e9e4d8;
  }
  .hub path {
    stroke: #b9b2a2;
    stroke-width: 1.6;
  }
  .hub .hole {
    fill: #1d1d21;
  }
  .glass {
    fill: rgba(255, 255, 255, 0.07);
    stroke: rgba(255, 255, 255, 0.12);
  }
  .screw {
    fill: #4a4a50;
  }
  .grip {
    stroke: rgba(255, 255, 255, 0.1);
    stroke-width: 1.4;
  }

  .hub {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Hovering turns the reels, like a tape winding on. */
  a.tape:hover .hub,
  a.tape:focus-visible .hub,
  .tape[aria-disabled='true']:hover .hub {
    animation: tape-spin 1.8s linear infinite;
  }

  .title {
    margin: 10px 0 0;
    font-family: var(--head);
    font-size: 1.02rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .meta {
    margin: 0;
    font-size: 0.7rem;
  }

  @keyframes tape-spin {
    to {
      transform: rotate(-360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hub {
      animation: none !important;
    }
  }
</style>
