---
// A cork notice board with one sheet of paper pinned at the top.
// The paper swings a little on its pin when you point at it.
interface Props {
  quote: string;
  name: string;
  role: string;
}
const { quote, name, role } = Astro.props;
---

<div class="board">
  <div class="cork">
    <div class="hang" data-sheet>
      <span class="lift left" aria-hidden="true"></span>
      <span class="lift right" aria-hidden="true"></span>
      <figure class="sheet">
        <blockquote>
          <p>“{quote}”</p>
        </blockquote>
        <figcaption>
          <strong>{name}</strong>
          <span>{role}</span>
        </figcaption>
      </figure>
      <span class="pin" aria-hidden="true"></span>
    </div>
  </div>
</div>

<script>
  // Swing the sheet once each time the pointer arrives.
  for (const sheet of document.querySelectorAll<HTMLElement>('[data-sheet]')) {
    sheet.addEventListener('pointerenter', () => {
      if (sheet.classList.contains('swinging')) return;
      sheet.classList.add('swinging');
    });
    sheet.addEventListener('animationend', () => sheet.classList.remove('swinging'));
  }
</script>

<style>
  /* Oak frame around the cork. */
  .board {
    --frame: 14px;
    width: min(720px, 100%);
    margin: 36px auto 0;
    padding: var(--frame);
    border-radius: 4px;
    background-color: #a8703f;
    background-image:
      linear-gradient(rgba(255, 240, 220, 0.18), transparent 30%, rgba(40, 20, 5, 0.2)),
      url('/window/wood-h.svg');
    background-size:
      auto,
      640px 160px;
    box-shadow:
      inset 0 2px 0 rgba(255, 240, 220, 0.35),
      inset 0 -2px 0 rgba(40, 20, 5, 0.35),
      0 18px 30px -16px rgba(40, 25, 10, 0.55),
      0 4px 8px rgba(40, 25, 10, 0.18);
  }

  .cork {
    position: relative;
    padding: clamp(34px, 6vw, 52px) clamp(18px, 5vw, 44px) clamp(30px, 5vw, 44px);
    background: url('/board/cork.svg') 0 0 / 240px 240px;
    box-shadow:
      inset 0 3px 8px rgba(30, 15, 0, 0.55),
      inset 0 0 0 1px rgba(30, 15, 0, 0.5);
  }

  /* A cream sheet, slightly crooked, held by one pin at the top. */
  .hang {
    position: relative;
    transform: rotate(-1.4deg);
    transform-origin: 50% 14px;
  }

  .sheet {
    position: relative;
    margin: 0;
    padding: clamp(28px, 5vw, 40px) clamp(22px, 5vw, 40px) clamp(22px, 4vw, 30px);
    background:
      url('/board/paper.svg') 0 0 / 200px 200px,
      linear-gradient(170deg, #fbf6ea, #f3ead6 70%, #ece1c9);
    color: #2a241c;
    text-align: left;
    box-shadow:
      0 1px 1px rgba(40, 25, 10, 0.18),
      0 10px 14px -10px rgba(30, 15, 0, 0.5);
  }

  /* The lower corners lift off the board, so their shadow falls further. */
  .lift {
    position: absolute;
    bottom: 12px;
    width: 46%;
    height: 22px;
    box-shadow: 0 15px 13px rgba(25, 12, 0, 0.42);
  }
  .lift.left {
    left: 10px;
    transform: rotate(-3deg);
  }
  .lift.right {
    right: 10px;
    transform: rotate(3deg);
  }

  .hang.swinging {
    animation: sheet-swing 1.8s cubic-bezier(0.3, 0.6, 0.4, 1);
  }

  @keyframes sheet-swing {
    0% {
      transform: rotate(-1.4deg);
    }
    18% {
      transform: rotate(1.6deg);
    }
    38% {
      transform: rotate(-2.8deg);
    }
    58% {
      transform: rotate(-0.4deg);
    }
    78% {
      transform: rotate(-1.9deg);
    }
    100% {
      transform: rotate(-1.4deg);
    }
  }

  /* A red push pin: round head with a highlight, and its shadow on the paper. */
  .pin {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ff9b8a, #d23a2a 45%, #8d1d14 100%);
    box-shadow:
      3px 5px 4px rgba(40, 15, 0, 0.45),
      inset -1px -2px 2px rgba(60, 0, 0, 0.35);
  }
  .pin::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 3px;
    width: 4px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.75);
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    margin: 0;
    font-family: var(--head);
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    line-height: 1.45;
    color: #2a241c;
  }

  /* Who said it, bottom right. */
  figcaption {
    display: grid;
    justify-items: end;
    gap: 2px;
    margin-top: 26px;
    text-align: right;
  }

  figcaption strong {
    font-weight: 600;
    color: #2a241c;
  }

  figcaption span {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6a5d4b;
  }

  :global([data-theme='dark']) .board {
    filter: brightness(0.78);
  }

  @media (prefers-reduced-motion: reduce) {
    .hang.swinging {
      animation: none;
    }
  }
</style>
