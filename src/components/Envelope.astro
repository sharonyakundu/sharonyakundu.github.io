---
// An envelope seen from the back: a pocket, a flap and a wax seal.
// `open` shows it with the flap up, ready for a letter.
interface Props {
  open?: boolean;
}
const { open = false } = Astro.props;
const wax = `wax-${Math.random().toString(36).slice(2, 8)}`; // unique per envelope on the page
---

<div class:list={['env', { open }]} data-env>
  <span class="env-back"></span>
  <span class="env-front">
    <svg viewBox="0 0 160 100" preserveAspectRatio="none" aria-hidden="true">
      <polygon class="side" points="0,0 77,59 0,100"></polygon>
      <polygon class="side r" points="160,0 83,59 160,100"></polygon>
      <polygon class="bottom" points="0,100 80,47 160,100"></polygon>
      <path class="seam" d="M0 100 L80 47 L160 100"></path>
      <path class="seam soft" d="M0 0 L77 59 M160 0 L83 59"></path>
    </svg>
  </span>
  <span class="env-flap" data-env-flap>
    <i class="face out"></i>
    <i class="face in"></i>
  </span>
  <span class="seal" data-env-seal>
    <svg viewBox="0 0 40 40" aria-hidden="true">
      <defs>
        <radialGradient id={wax} cx="0.38" cy="0.32" r="0.75">
          <stop offset="0" stop-color="#6f8cff"></stop>
          <stop offset="0.5" stop-color="#2f55e8"></stop>
          <stop offset="1" stop-color="#162a8a"></stop>
        </radialGradient>
      </defs>
      <path
        fill={`url(#${wax})`}
        d="M20 2.5c3 0 4.2 2.2 6.7 3.1s5.2-.3 6.8 2.1.5 4.8 1.6 7.2 3.4 3.4 3.4 6.1-2.4 3.7-3.3 6.2.4 5.1-1.7 6.9-4.6.5-7 1.5S23.2 39 20 39s-4.4-2.2-6.9-3.2-5.1.4-6.9-1.6-.5-4.6-1.5-7S1.5 23.9 1.5 21s2.3-3.8 3.3-6.3-.4-5 1.6-6.8 4.6-.6 7-1.6S17 2.5 20 2.5Z"
      ></path>
      <circle cx="20" cy="20.6" r="12.2" fill="none" stroke="rgba(10,20,80,0.45)" stroke-width="1.4"></circle>
      <circle cx="20" cy="20.6" r="13.2" fill="none" stroke="rgba(170,190,255,0.35)" stroke-width="0.7"></circle>
      <text x="20.6" y="25.3" text-anchor="middle" class="mark-hi">SK</text>
      <text x="20" y="24.7" text-anchor="middle" class="mark">SK</text>
    </svg>
  </span>
</div>

<style>
  .env {
    --paper: #f1e8d3;
    position: relative;
    width: 100%;
    aspect-ratio: 1.6;
  }

  .env-back,
  .env-front,
  .env-flap {
    position: absolute;
    left: 0;
    width: 100%;
  }

  /* Inside of the envelope: a fine patterned lining. */
  .env-back {
    z-index: 1;
    top: 0;
    height: 100%;
    border-radius: 3px;
    background:
      repeating-linear-gradient(45deg, rgba(80, 90, 140, 0.13) 0 2px, transparent 2px 5px),
      linear-gradient(#dccfb3, #cfc09f);
    box-shadow: 0 10px 16px -10px rgba(40, 25, 10, 0.55);
  }

  /* The pocket: everything but a V at the top. */
  .env-front {
    z-index: 3;
    top: 0;
    height: 100%;
    clip-path: polygon(0 0, 50% 56%, 100% 0, 100% 100%, 0 100%);
    background: #ece2cb;
    border-radius: 3px;
  }
  .env-front svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .side {
    fill: #e9dec5;
  }
  .side.r {
    fill: #e4d8bd;
  }
  .bottom {
    fill: #f3ebd8;
  }
  .seam {
    fill: none;
    stroke: rgba(110, 80, 30, 0.28);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  .seam.soft {
    stroke: rgba(110, 80, 30, 0.14);
  }

  /* The flap folds over the top. Up when open, down when closed. */
  .env-flap {
    z-index: 4;
    top: 0;
    height: 60%;
    transform-origin: 50% 0;
    transform-style: preserve-3d;
    transform: perspective(700px) rotateX(0deg);
  }
  .open .env-flap {
    z-index: 1;
    transform: perspective(700px) rotateX(180deg);
  }
  .face {
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, 100% 0, 52% 98%, 48% 98%);
    backface-visibility: hidden;
  }
  .face.out {
    background: linear-gradient(#f8f2e4, #efe5cf);
  }
  /* the closed flap throws a thin shadow on the pocket */
  .env-flap::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: polygon(0 0, 100% 0, 52% 100%, 48% 100%);
    background: rgba(90, 60, 20, 0.22);
    transform: translateZ(-1px) translateY(3px);
    filter: blur(1.5px);
  }
  .open .env-flap::after {
    display: none;
  }
  .face.in {
    transform: rotateX(180deg);
    background:
      repeating-linear-gradient(45deg, rgba(80, 90, 140, 0.13) 0 2px, transparent 2px 5px),
      linear-gradient(#d5c7a8, #dccfb3);
  }

  .seal {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 58%;
    width: 19%;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 2px 2px rgba(10, 20, 60, 0.4));
  }
  .open .seal {
    opacity: 0;
  }
  .seal svg {
    display: block;
    width: 100%;
  }
  .mark,
  .mark-hi {
    font: 700 11px/1 var(--head);
    letter-spacing: -0.5px;
  }
  .mark {
    fill: rgba(8, 18, 70, 0.55);
  }

  /* Dimmed piece by piece at night, so the pocket still works as a layer. */
  :global([data-theme='dark']) .env-back,
  :global([data-theme='dark']) .env-front,
  :global([data-theme='dark']) .face.in {
    filter: brightness(0.86);
  }
  :global([data-theme='dark']) .face.out {
    filter: brightness(0.86);
  }
  .mark-hi {
    fill: rgba(190, 205, 255, 0.45);
  }
</style>
