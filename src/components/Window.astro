---
// A wooden sash window looking onto Wrocław. The lower sash slides up:
// click it, or drag it with a mouse.
import Scene from './Scene.astro';
---

<figure class="window" data-window data-open="false">
  <div class="casing">
    <div class="reveal">
      <!-- The four inner faces of the wall opening, seen in depth. -->
      <span class="jamb top wood-h" aria-hidden="true"></span>
      <span class="jamb bottom wood-h" aria-hidden="true"></span>
      <span class="jamb left wood-v" aria-hidden="true"></span>
      <span class="jamb right wood-v" aria-hidden="true"></span>
      <div class="opening" data-opening>
        <Scene />
        <div class="sash upper" aria-hidden="true">
          <span class="glass"></span>
          <span class="rail wood-h top"></span>
          <span class="rail wood-h meet"></span>
          <span class="stile wood-v left"></span>
          <span class="stile wood-v right"></span>
          <span class="keeper"></span>
        </div>
        <button class="sash lower" type="button" data-sash aria-pressed="false" aria-label="Open the window">
          <span class="glass"></span>
          <span class="muntin wood-v m1"></span>
          <span class="muntin wood-v m2"></span>
          <span class="rail wood-h meet"></span>
          <span class="rail wood-h bottom"></span>
          <span class="stile wood-v left"></span>
          <span class="stile wood-v right"></span>
          <span class="lock"><i></i></span>
          <span class="lift l1"></span>
          <span class="lift l2"></span>
        </button>
        <span class="beads" aria-hidden="true"></span>
      </div>
    </div>
  </div>
  <div class="sill">
    <div class="sill-top wood-h"></div>
    <div class="sill-front wood-h"></div>
  </div>
  <div class="apron wood-h"></div>

  <figcaption>
    <span class="label" data-caption>Lift the window</span>
  </figcaption>
  <p class="sr-only">
    Illustration: the main building of the University of Wrocław beside the Odra river at sunrise, with cars, a tram
    and people on the street below, seen through a wooden window.
  </p>
</figure>

<script>
  import '../scripts/window';
</script>

<style>
  .window {
    --open: 0;
    --wood-dim: rgba(0, 0, 0, 0);
    --bead-hi: rgba(255, 240, 220, 0.3);
    --bead-lo: rgba(40, 20, 5, 0.32);
    --sheen: rgba(255, 246, 232, 0.16);
    --sun-in: 1; /* daylight falling in through the window */
    --depth: 2.2cqw; /* how deep the wall opening looks */
    container-type: inline-size;
    position: relative;
    /* Same size as the window on the reference site: 620px wide from one
       end of the sill to the other (on phones, 88% of the screen width),
       and always 1.36 times as wide as it is tall. The sill sticks out
       2.4% on each side, hence the 1.048. */
    width: calc(min(620px, 88vw) / 1.048);
    margin: 0 auto;
  }

  :global([data-theme='dark']) .window {
    --wood-dim: rgba(14, 10, 8, 0.42);
    --bead-hi: rgba(255, 240, 220, 0.12);
    --sheen: rgba(255, 220, 170, 0.07);
    --sun-in: 0;
  }

  /* Wood: grain runs along each piece, a soft varnish sheen across it.
     Every piece shifts the texture so no two show the same grain. */
  .wood-h,
  .casing {
    --gx: 0px;
    --gy: 0px;
    background-color: #a8703f;
    background-image:
      linear-gradient(104deg, transparent 20%, var(--sheen) 34%, transparent 46%, transparent 70%, var(--sheen) 80%, transparent 88%),
      linear-gradient(var(--wood-dim), var(--wood-dim)),
      url('/window/wood-h.svg');
    background-size:
      auto,
      auto,
      640px 160px;
    background-position:
      0 0,
      0 0,
      var(--gx) var(--gy);
  }
  .wood-v {
    --gx: 0px;
    --gy: 0px;
    background-color: #a8703f;
    background-image:
      linear-gradient(194deg, transparent 20%, var(--sheen) 34%, transparent 46%),
      linear-gradient(var(--wood-dim), var(--wood-dim)),
      url('/window/wood-v.svg');
    background-size:
      auto,
      auto,
      160px 640px;
    background-position:
      0 0,
      0 0,
      var(--gx) var(--gy);
  }

  /* Outer casing with mitred side pieces. */
  .casing {
    position: relative;
    padding: 3.6cqw;
    border-radius: 0.5cqw 0.5cqw 0 0;
    box-shadow:
      inset 0 0.3cqw 0 var(--bead-hi),
      inset 0 0 0 0.12cqw var(--bead-lo),
      0 2cqw 3cqw -2cqw rgba(30, 15, 0, 0.45),
      0 4cqw 7cqw -3cqw rgba(30, 15, 0, 0.3);
  }

  .casing::before,
  .casing::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3.6cqw;
    background-color: #a8703f;
    background-image:
      linear-gradient(90deg, var(--bead-hi), transparent 22%, var(--bead-lo) 48%, transparent 56%, var(--bead-hi) 78%, var(--bead-lo)),
      linear-gradient(var(--wood-dim), var(--wood-dim)),
      url('/window/wood-v.svg');
    background-size:
      auto,
      auto,
      160px 640px;
  }

  .casing::before {
    left: 0;
    background-position:
      0 0,
      0 0,
      -37px -210px;
    clip-path: polygon(0 0, 100% 3.6cqw, 100% calc(100% - 3.6cqw), 0 100%);
  }

  .casing::after {
    right: 0;
    background-position:
      0 0,
      0 0,
      -91px -40px;
    /* same shape as the left piece, mirrored together with its shading */
    clip-path: polygon(0 0, 100% 3.6cqw, 100% calc(100% - 3.6cqw), 0 100%);
    transform: scaleX(-1);
  }

  /* Moulding profile on the top and bottom pieces, with a dark line at each mitre joint. */
  .casing > .reveal::before,
  .casing > .reveal::after {
    content: '';
    position: absolute;
    left: -3.6cqw;
    right: -3.6cqw;
    height: 3.6cqw;
    background:
      linear-gradient(45deg, transparent calc(50% - 0.06cqw), rgba(30, 14, 2, 0.35) 50%, transparent calc(50% + 0.06cqw)) left / 3.6cqw 100% no-repeat,
      linear-gradient(-45deg, transparent calc(50% - 0.06cqw), rgba(30, 14, 2, 0.35) 50%, transparent calc(50% + 0.06cqw)) right / 3.6cqw 100% no-repeat,
      linear-gradient(var(--bead-hi), transparent 22%, var(--bead-lo) 48%, transparent 56%, var(--bead-hi) 78%, var(--bead-lo));
    pointer-events: none;
  }
  .casing > .reveal::before {
    top: -3.6cqw;
    clip-path: polygon(0 0, 100% 0, calc(100% - 3.6cqw) 100%, 3.6cqw 100%);
  }
  .casing > .reveal::after {
    bottom: -3.6cqw;
    transform: scaleY(-1);
    clip-path: polygon(0 0, 100% 0, calc(100% - 3.6cqw) 100%, 3.6cqw 100%);
  }

  /* The wall opening: four faces that turn away from us. The top one is in
     shade, the sides catch some light, the bottom catches daylight. */
  .reveal {
    position: relative;
    padding: var(--depth);
    background: #3b2414;
    box-shadow:
      inset 0 0 0 0.12cqw var(--bead-lo),
      0 0 0 0.2cqw var(--bead-hi);
  }

  .jamb {
    position: absolute;
    pointer-events: none;
  }
  .jamb::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .jamb.top {
    --gx: -310px;
    --gy: -60px;
    top: 0;
    left: 0;
    right: 0;
    height: var(--depth);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--depth)) 100%, var(--depth) 100%);
  }
  .jamb.top::after {
    background: linear-gradient(rgba(25, 12, 2, 0.62), rgba(25, 12, 2, 0.4));
  }
  .jamb.bottom {
    --gx: -140px;
    --gy: -120px;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--depth);
    clip-path: polygon(var(--depth) 0, calc(100% - var(--depth)) 0, 100% 100%, 0 100%);
  }
  .jamb.bottom::after {
    background:
      linear-gradient(rgba(255, 214, 160, calc(0.22 * var(--sun-in))), transparent),
      linear-gradient(rgba(30, 14, 2, 0.12), rgba(30, 14, 2, 0.12));
  }
  .jamb.left,
  .jamb.right {
    top: 0;
    bottom: 0;
    width: var(--depth);
  }
  .jamb.left {
    --gx: -20px;
    --gy: -330px;
    left: 0;
    clip-path: polygon(0 0, 100% var(--depth), 100% calc(100% - var(--depth)), 0 100%);
  }
  .jamb.right {
    --gx: -80px;
    --gy: -90px;
    right: 0;
    clip-path: polygon(0 var(--depth), 100% 0, 100% 100%, 0 calc(100% - var(--depth)));
  }
  .jamb.left::after {
    background: linear-gradient(90deg, rgba(25, 12, 2, 0.45), rgba(25, 12, 2, 0.22));
  }
  .jamb.right::after {
    background: linear-gradient(270deg, rgba(25, 12, 2, 0.5), rgba(25, 12, 2, 0.28));
  }

  .opening {
    position: relative;
    aspect-ratio: 3 / 2; /* makes the whole window 1.36 times as wide as tall, like the reference */
    overflow: hidden;
    background: #e9cfa9;
    box-shadow: 0 0 0 0.12cqw rgba(20, 10, 0, 0.5);
  }

  .opening :global(.scene) {
    position: absolute;
    inset: 0;
  }

  /* Fine film grain over the street, as in a photograph. */
  .opening::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/window/grain.png') 0 0 / 200px 200px;
    mix-blend-mode: overlay;
    opacity: 0.32;
    pointer-events: none;
  }

  /* The sashes run in channels: a dark gap down each side. */
  .beads {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    box-shadow:
      inset 0.32cqw 0 0.45cqw -0.12cqw rgba(15, 8, 0, 0.6),
      inset -0.32cqw 0 0.45cqw -0.12cqw rgba(15, 8, 0, 0.6),
      inset 0 0.5cqw 0.7cqw -0.2cqw rgba(15, 8, 0, 0.55);
  }

  /* Sashes */
  .sash {
    position: absolute;
    left: 0;
    right: 0;
    height: 52%;
    display: block;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
  }

  .upper {
    top: 0;
    z-index: 1;
  }

  .lower {
    top: 48%;
    z-index: 2;
    cursor: grab;
    touch-action: manipulation;
    transform: translateY(calc(var(--open) * -88%));
    -webkit-tap-highlight-color: transparent;
    /* the inner sash stands a little in front: a soft shadow on the outer one */
    filter: drop-shadow(0 0.5cqw 0.6cqw rgba(20, 10, 0, 0.28));
  }

  .lower:active {
    cursor: grabbing;
  }

  .lower:focus-visible {
    outline: none;
  }

  .lower:focus-visible .lock {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .rail,
  .stile,
  .muntin {
    position: absolute;
    box-shadow:
      inset 0 0.2cqw 0 var(--bead-hi),
      inset 0 -0.25cqw 0 var(--bead-lo),
      0 0.15cqw 0.35cqw rgba(20, 10, 0, 0.3);
  }

  .rail {
    left: 0;
    right: 0;
  }
  .rail.top {
    --gx: -220px;
    --gy: -18px;
    top: 0;
    height: 2.4cqw;
  }
  .rail.meet {
    height: 2.1cqw;
  }
  .upper .rail.meet {
    --gx: -400px;
    --gy: -95px;
    bottom: 0;
  }
  .lower .rail.meet {
    --gx: -60px;
    --gy: -132px;
    top: 0;
  }
  .rail.bottom {
    --gx: -505px;
    --gy: -48px;
    bottom: 0;
    height: 3.3cqw;
  }

  .stile {
    top: 0;
    bottom: 0;
    width: 2.3cqw;
    box-shadow:
      inset 0.2cqw 0 0 var(--bead-hi),
      inset -0.25cqw 0 0 var(--bead-lo),
      0.15cqw 0 0.35cqw rgba(20, 10, 0, 0.25);
  }
  .stile.left {
    left: 0;
  }
  .stile.right {
    right: 0;
  }
  .upper .stile.left {
    --gx: -12px;
    --gy: -470px;
  }
  .upper .stile.right {
    --gx: -118px;
    --gy: -260px;
  }
  .lower .stile.left {
    --gx: -64px;
    --gy: -120px;
  }
  .lower .stile.right {
    --gx: -96px;
    --gy: -390px;
  }

  .muntin {
    top: 2cqw;
    bottom: 3cqw;
    width: 0.85cqw;
    box-shadow:
      inset 0.15cqw 0 0 var(--bead-hi),
      inset -0.18cqw 0 0 var(--bead-lo),
      0.2cqw 0.2cqw 0.4cqw rgba(20, 10, 0, 0.3);
  }
  .m1 {
    --gx: -30px;
    --gy: -200px;
    left: calc(2.3cqw + (100% - 4.6cqw) / 3 - 0.425cqw);
  }
  .m2 {
    --gx: -140px;
    --gy: -520px;
    left: calc(2.3cqw + (100% - 4.6cqw) * 2 / 3 - 0.425cqw);
  }

  /* Glass: a faint green-grey tint that softens what is behind it, a
     reflection of the room, streaks of light and a little dust. */
  .glass {
    position: absolute;
    inset: 2cqw 2.3cqw 2cqw;
    overflow: hidden;
    background:
      linear-gradient(
        116deg,
        rgba(255, 255, 255, 0.24) 0%,
        rgba(255, 255, 255, 0.06) 20%,
        rgba(255, 255, 255, 0) 36%,
        rgba(255, 255, 255, 0.12) 50%,
        rgba(255, 255, 255, 0) 60%,
        rgba(255, 255, 255, 0.05) 80%
      ),
      radial-gradient(120% 80% at 15% 115%, rgba(120, 70, 30, 0.14), transparent 60%),
      rgba(214, 228, 222, 0.12);
    box-shadow:
      inset 0.5cqw 0.5cqw 1cqw rgba(20, 10, 0, 0.22),
      inset 0 0 0 0.2cqw rgba(70, 100, 90, 0.14);
  }
  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/window/dust.png') 0 0 / 320px 320px;
    opacity: 0.35;
  }
  .upper .glass {
    top: 2.4cqw;
    bottom: 2.1cqw;
  }
  .upper .glass::after {
    background-position: -150px -60px;
  }
  .lower .glass {
    top: 2.1cqw;
    bottom: 3.3cqw;
  }
  :global([data-theme='dark']) .glass {
    background:
      linear-gradient(116deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 30%, rgba(255, 255, 255, 0.05) 50%, rgba(255, 255, 255, 0) 60%),
      radial-gradient(90% 70% at 50% -10%, rgba(255, 196, 132, 0.1), transparent 70%),
      rgba(160, 180, 220, 0.05);
  }
  :global([data-theme='dark']) .glass::after {
    opacity: 0.18;
  }

  /* Brass: a crescent sash lock on the meeting rails, and two lifts. */
  .lock,
  .keeper,
  .lift {
    position: absolute;
    left: 50%;
    background: linear-gradient(#f3d995, #c99a38 45%, #8c6522);
    box-shadow:
      0 0.25cqw 0.3cqw rgba(30, 15, 0, 0.45),
      inset 0 0.1cqw 0 rgba(255, 255, 255, 0.6);
  }
  .keeper {
    bottom: 0.35cqw;
    width: 2.6cqw;
    height: 1.1cqw;
    transform: translateX(0.6cqw);
    border-radius: 0.25cqw;
  }
  .lock {
    top: 0.45cqw;
    width: 3.2cqw;
    height: 1.2cqw;
    transform: translateX(-2.4cqw);
    border-radius: 0.3cqw;
  }
  .lock i {
    position: absolute;
    left: 1.2cqw;
    top: -0.55cqw;
    width: 3.4cqw;
    height: 1.7cqw;
    border-radius: 0 3cqw 3cqw 0 / 0 1.7cqw 1.7cqw 0;
    background: linear-gradient(160deg, #f8e3a8, #c99a38 55%, #7f5a1c);
    box-shadow: 0.2cqw 0.25cqw 0.3cqw rgba(30, 15, 0, 0.45);
  }
  .lock i::before {
    content: '';
    position: absolute;
    left: -0.5cqw;
    top: 0.45cqw;
    width: 0.8cqw;
    height: 0.8cqw;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff2c8, #b8892e 60%, #6e4c15);
  }
  .lift {
    bottom: 0.9cqw;
    width: 3.4cqw;
    height: 1.25cqw;
    border-radius: 0.3cqw 0.3cqw 1cqw 1cqw;
  }
  .lift::after {
    content: '';
    position: absolute;
    left: 0.6cqw;
    right: 0.6cqw;
    bottom: 0.18cqw;
    height: 0.4cqw;
    border-radius: 0.3cqw;
    background: rgba(60, 35, 5, 0.55);
  }
  .l1 {
    left: 22%;
  }
  .l2 {
    left: auto;
    right: 22%;
  }

  /* Sill and apron */
  .sill {
    position: relative;
    z-index: 3;
    margin: 0 -2.4cqw;
  }
  .sill-top {
    --gx: -260px;
    --gy: -100px;
    position: relative;
    height: 2.6cqw;
    clip-path: polygon(1.6cqw 0, calc(100% - 1.6cqw) 0, 100% 100%, 0 100%);
  }
  /* Daylight falling through the window onto the sill. */
  .sill-top::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 140% at 50% 0%, rgba(255, 220, 170, calc(0.32 * var(--sun-in))), transparent 70%),
      linear-gradient(rgba(255, 240, 220, 0.12), rgba(40, 20, 5, 0.2));
    transition: opacity 0.6s;
  }
  .sill-front {
    --gx: -30px;
    --gy: -12px;
    height: 2.2cqw;
    border-radius: 0 0 0.4cqw 0.4cqw;
    box-shadow:
      inset 0 0.25cqw 0 var(--bead-hi),
      inset 0 -0.35cqw 0 var(--bead-lo),
      0 1.4cqw 2cqw -1.2cqw rgba(30, 15, 0, 0.5);
  }
  .apron {
    --gx: -350px;
    --gy: -70px;
    height: 1.8cqw;
    margin: 0 2cqw;
    border-radius: 0 0 0.5cqw 0.5cqw;
    box-shadow:
      inset 0 0.5cqw 0.6cqw -0.2cqw rgba(30, 15, 0, 0.45),
      inset 0 -0.25cqw 0 var(--bead-lo),
      0 1cqw 1.6cqw -1cqw rgba(30, 15, 0, 0.4);
  }

  figcaption {
    display: grid;
    justify-items: center;
    gap: 6px;
    margin-top: 22px;
    text-align: center;
  }
</style>
