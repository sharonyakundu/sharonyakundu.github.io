---
import { site, nav } from '../data/site';
import LampCord from './LampCord.astro';
const here = Astro.url.pathname;
---

<header class="site-head">
  <a class="label name" href="/">{site.name}</a>
  <p class="label place">
    {site.location}
    <svg class="flag" viewBox="0 0 8 5" role="img" aria-label="Poland">
      <path fill="#fff" d="M0 0h8v2.5H0z"></path>
      <path fill="#dc143c" d="M0 2.5h8V5H0z"></path>
    </svg>
  </p>
  <p class="label clock"><time data-clock data-zone={site.timeZone}>&nbsp;</time></p>
  <p class="label weather" data-weather>&nbsp;</p>

  <nav aria-label="Main">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a class="label" href={item.href} aria-current={here === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <LampCord />
</header>

<script>
  // Local time in Wrocław, refreshed every 30 seconds.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: clock.dataset.zone,
      timeZoneName: 'short',
    });
    const tick = () => (clock.textContent = format.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }

  // Current weather in Wrocław from Open-Meteo (free, no key needed).
  // Kept for 20 minutes on this device so every page view doesn't ask again.
  type Now = { at: number; temp: number; code: number; day: boolean };

  const KINDS: [number[], string, string, string][] = [
    [[0], 'Clear', '☀️', '🌙'],
    [[1], 'Mostly clear', '🌤️', '🌙'],
    [[2], 'Partly cloudy', '⛅', '☁️'],
    [[3], 'Cloudy', '☁️', '☁️'],
    [[45, 48], 'Fog', '🌫️', '🌫️'],
    [[51, 53, 55, 56, 57], 'Drizzle', '🌦️', '🌧️'],
    [[61, 63, 65, 66, 67], 'Rain', '🌧️', '🌧️'],
    [[71, 73, 75, 77], 'Snow', '🌨️', '🌨️'],
    [[80, 81, 82], 'Showers', '🌦️', '🌧️'],
    [[85, 86], 'Snow showers', '🌨️', '🌨️'],
    [[95, 96, 99], 'Storm', '⛈️', '⛈️'],
  ];

  const weather = document.querySelector<HTMLElement>('[data-weather]');

  const show = (now: Now) => {
    if (!weather) return;
    const kind = KINDS.find(([codes]) => codes.includes(now.code));
    const temp = Math.round(now.temp);
    const degrees = `${temp < 0 ? '−' : ''}${Math.abs(temp)}°C`;
    weather.textContent = kind ? `${degrees} · ${kind[1]} ${now.day ? kind[2] : kind[3]}` : degrees;
  };

  const load = async () => {
    let saved: Now | null = null;
    try {
      saved = JSON.parse(localStorage.getItem('wroclaw-weather') ?? 'null');
    } catch {}
    if (saved) show(saved);
    if (saved && Date.now() - saved.at < 20 * 60_000) return;

    try {
      const url =
        'https://api.open-meteo.com/v1/forecast?latitude=51.11&longitude=17.03&current=temperature_2m,weather_code,is_day';
      const res = await fetch(url);
      if (!res.ok) return;
      const data = await res.json();
      const now: Now = {
        at: Date.now(),
        temp: data.current.temperature_2m,
        code: data.current.weather_code,
        day: data.current.is_day === 1,
      };
      show(now);
      try {
        localStorage.setItem('wroclaw-weather', JSON.stringify(now));
      } catch {}
    } catch {
      // No weather is fine: the line simply stays empty.
    }
  };
  void load();
</script>

<style>
  .site-head {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 28px 16px 8px;
    text-align: center;
  }

  .site-head p {
    margin: 0;
  }

  .name {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }

  .place {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .flag {
    width: 14px;
    height: 9px;
    border-radius: 1px;
    box-shadow: 0 0 0 0.5px rgba(23, 22, 15, 0.25);
  }

  .clock,
  .weather {
    min-height: 1.6em;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 24px;
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    padding-block: 6px;
    display: inline-block;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
